{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "IoT Platform API",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/iot-platform",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "presentation": {
        "hidden": true
      },
      "args": [
        "--env-file",
        "${workspaceFolder}/.env.local"
      ]
    },
    {
      "name": "IoT Platform Web",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}/iot_front",
      "presentation": {
        "hidden": true
      },
      "windows": {
        "command": "npm.cmd run dev"
      }
    },
    {
      "name": "Backup Service",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/backup-service",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "presentation": {
        "hidden": true
      },
      "args": [
        "--env-file",
        "${workspaceFolder}/.env.local"
      ]
    },
    {
      "name": "GB26875 Gateway",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/gb26875-gateway",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "presentation": {
        "hidden": true
      },
      "env": {
        "GB26875_LISTEN": ":26875",
        "GB26875_UDP_LISTEN": ":26875",
        "GB26875_PLATFORM_URL": "http://localhost:8081",
        "GB26875_TENANT": "tenant_001"
      }
    },
    {
      "name": "IoT Platform API (Run)",
      "type": "node-terminal",
      "request": "launch",
      "command": "go run ./cmd/iot-platform --env-file .env.local",
      "cwd": "${workspaceFolder}",
      "presentation": {
        "hidden": true
      }
    },
    {
      "name": "Backup Service (Run)",
      "type": "node-terminal",
      "request": "launch",
      "command": "go run ./cmd/backup-service --env-file .env.local",
      "cwd": "${workspaceFolder}",
      "presentation": {
        "hidden": true
      }
    },
    {
      "name": "GB26875 Gateway (Run)",
      "type": "node-terminal",
      "request": "launch",
      "command": "go run ./cmd/gb26875-gateway",
      "cwd": "${workspaceFolder}",
      "presentation": {
        "hidden": true
      },
      "env": {
        "GB26875_LISTEN": ":26875",
        "GB26875_UDP_LISTEN": ":26875",
        "GB26875_PLATFORM_URL": "http://localhost:8081",
        "GB26875_TENANT": "tenant_001"
      }
    }
  ],
  "compounds": [
    {
      "name": "运行 IoT Platform (API + Web)",
      "configurations": [
        "IoT Platform API (Run)",
        "IoT Platform Web"
      ],
      "presentation": {
        "group": "iot-platform-run",
        "order": 1
      },
      "stopAll": true
    },
    {
      "name": "运行 IoT Platform + GB26875 Gateway",
      "configurations": [
        "IoT Platform API (Run)",
        "IoT Platform Web",
        "GB26875 Gateway (Run)"
      ],
      "presentation": {
        "group": "iot-platform-run",
        "order": 3
      },
      "stopAll": true
    },
    {
      "name": "运行 IoT Platform (API + Web + Backup)",
      "configurations": [
        "IoT Platform API (Run)",
        "IoT Platform Web",
        "Backup Service (Run)"
      ],
      "presentation": {
        "group": "iot-platform-run",
        "order": 2
      },
      "stopAll": true
    },
    {
      "name": "调试 IoT Platform (API + Web)",
      "configurations": [
        "IoT Platform API",
        "IoT Platform Web"
      ],
      "presentation": {
        "group": "iot-platform",
        "order": 1
      },
      "stopAll": true
    },
    {
      "name": "调试 IoT Platform + GB26875 Gateway",
      "configurations": [
        "IoT Platform API",
        "IoT Platform Web",
        "GB26875 Gateway"
      ],
      "presentation": {
        "group": "iot-platform",
        "order": 3
      },
      "stopAll": true
    },
    {
      "name": "调试 IoT Platform (API + Web + Backup)",
      "configurations": [
        "IoT Platform API",
        "IoT Platform Web",
        "Backup Service"
      ],
      "presentation": {
        "group": "iot-platform",
        "order": 2
      },
      "stopAll": true
    }
  ]
}
